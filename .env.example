# HEHA Swipe client env
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Fail-closed legal gate. Keep false/unset until the category agreement is
# counsel-approved and the PR #127 successor evidence path is exact-head proven.
VITE_ENABLE_PARTNER_AGREEMENT_ACCEPTANCE=false

# Owner-safe, server-derived launch receipt projection. Keep false/unset until
# get_partner_onboarding_capabilities_v1 and its RLS/BOLA proof are deployed.
VITE_ENABLE_PARTNER_ONBOARDING_CAPABILITIES=false

# Replaces browser SELECT-then-INSERT with one idempotent, server-locked create
# or resume RPC. Keep false until uniqueness, recipient-claim, replay, and BOLA
# proofs pass. Existing invited businesses must use their protected invite.
VITE_ENABLE_PROTECTED_PARTNER_APPLICATION=false

# Opaque invite fragments are consumed into session storage and immediately
# removed from the URL. Keep false until recipient binding, expiry, single use,
# replay, wrong-recipient, existing-business, and BOLA proofs pass.
VITE_ENABLE_PROTECTED_PARTNER_CLAIM=false

# Fail-closed PWA release gate. Keep false/unset until the service worker,
# install prompt, icons, standalone launch, and rollback cleanup pass on real
# iPhone and Android devices.
VITE_ENABLE_HEHA_SWIPE_PWA=false

# HEHA Local remains a separate release. Its install link stays locked until
# the exact HTTPS origin and independent manifest/service-worker proof pass.
VITE_ENABLE_HEHA_LOCAL_INSTALL=false
VITE_HEHA_LOCAL_URL=https://hehalocal.app

# Optional Make.com automations
VITE_MAKE_NEW_USER_WEBHOOK=
VITE_MAKE_PARTNER_APPROVAL_WEBHOOK=
