{
    "name": "heha-swipe",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:store": "npm run env:check:store && VITE_RELEASE_CHANNEL=store vite build",
        "preview": "vite preview",
        "assets:store": "node scripts/generate-store-assets.mjs",
        "assets:check": "node scripts/generate-store-assets.mjs --check",
        "env:check:store": "node scripts/require-store-runtime-env.mjs",
        "native:sync": "npm run build:store && npx cap sync",
        "test:store-release": "node --test test/store-release/*.test.mjs",
        "release:verify": "npm run test:store-release && npm run assets:check && npm run build:store && npx cap sync"
    },
    "dependencies": {
        "@capacitor/android": "^8.5.1",
        "@capacitor/core": "^8.5.1",
        "@capacitor/ios": "^8.5.1",
        "@supabase/supabase-js": "^2.106.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@capacitor/cli": "^8.5.1",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "typescript": "^5.9.3",
        "vite": "^8.2.2"
    },
    "overrides": {
        "browserslist": "4.28.8",
        "nanoid": "3.3.18",
        "postcss": "8.5.26",
        "uuid": "11.1.1"
    }
}
